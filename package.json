{
  "name": "rubiks-solver",
  "version": "3.0.0",
  "private": true,
  "description": "Rubik's Cube solver (two-phase, Beginner and CFOP methods) with photo scanning, in dependency-free TypeScript",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "solve": "tsx scripts/solve.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node web/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
